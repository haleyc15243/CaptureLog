import com.rhc.capturelog.data.dailynote.Tag;
import com.rhc.capturelog.data.dailynote.TagColor;

CREATE TABLE IF NOT EXISTS tag (
    id TEXT AS Tag.Id PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    color INTEGER AS TagColor NOT NULL,
    usageCount INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM tag
ORDER BY usageCount DESC, name ASC;

insert:
INSERT OR REPLACE INTO tag(
    id,
    name,
    color,
    usageCount
) VALUES (
    ?, ?, ?, ?
);

incrementUsage:
UPDATE tag SET usageCount = usageCount + 1 WHERE name = ?;

delete:
DELETE FROM tag WHERE name = ?;