import com.rhc.capturelog.data.dailynote.DailyNote;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS daily_note (
    id TEXT AS DailyNote.Id PRIMARY KEY NOT NULL,
    date INTEGER AS Instant NOT NULL,
    title TEXT NOT NULL,
    createdAt INTEGER AS Instant NOT NULL,
    updatedAt INTEGER AS Instant NOT NULL,
    UNIQUE(date)
);

CREATE INDEX idx_dailynote_date ON daily_note(date);

selectAll:
SELECT * FROM daily_note;

selectByDate:
SELECT * FROM daily_note WHERE date = ?;

selectRecent:
SELECT * FROM daily_note ORDER BY date DESC LIMIT ?;

insert:
INSERT OR REPLACE INTO daily_note(id, date, title, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?);

updateReflections:
UPDATE daily_note SET updatedAt = ? WHERE id = ?;