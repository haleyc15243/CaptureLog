import com.rhc.capturelog.data.dailynote.CaptureTemplate;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS capture_template (
    id TEXT AS CaptureTemplate.Id PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    color TEXT NOT NULL,
    fieldsJson TEXT NOT NULL,  -- JSON array of TemplateField
    isDefault INTEGER NOT NULL DEFAULT 0,
    isArchived INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER AS Instant NOT NULL,
    updatedAt INTEGER AS Instant NOT NULL
);

CREATE INDEX idx_template_default ON capture_template(isDefault) WHERE isDefault = 1;

selectAll:
SELECT * FROM capture_template
WHERE isArchived = 0
ORDER BY name;

selectDefaults:
SELECT * FROM capture_template
WHERE isDefault = 1 AND isArchived = 0;

selectById:
SELECT * FROM capture_template
WHERE id = ?;

insert:
INSERT OR REPLACE INTO capture_template(
    id,
    name,
    icon,
    color,
    fieldsJson,
    isDefault,
    isArchived,
    createdAt,
    updatedAt
) VALUES (
?, ?, ?, ?, ?, ?, ?, ?, ?
);

archive:
UPDATE capture_template
SET isArchived = 1, updatedAt = ?
WHERE id = ?;